				{
					"name": "Check Account creation with invalid data",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"\r",
									"var invalidSchema = {\r",
									"  \"type\": \"object\",\r",
									"  \"properties\": {\r",
									"    \"status\": {\r",
									"      \"type\": \"string\"\r",
									"    },\r",
									"    \"message\": {\r",
									"      \"type\": \"string\"\r",
									"    }\r",
									"  },\r",
									"  \"required\": [\r",
									"    \"status\",\r",
									"    \"message\"\r",
									"  ]\r",
									"}\r",
									"\r",
									"    pm.test(\"Status code is 400\", function () {\r",
									"        pm.response.to.have.status(400);\r",
									"    });\r",
									"\r",
									"    pm.test(\"Status is error\", function () {\r",
									"        pm.expect(jsonData.status).to.eql(\"error\");\r",
									"    });\r",
									"\r",
									"    pm.test('Schema is valid on failed account creation', function () {\r",
									"        pm.expect(tv4.validate(pm.response.json(), invalidSchema)).to.be.true;\r",
									"    });\r",
									"\r",
									"\r",
									""
								],
