				{
					"name": "Check Update User Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"//data sent",
									"var jsonDataReq = JSON.parse(pm.request.body);",
									"var sentName = jsonDataReq.name;",
									"var sentlastName = jsonDataReq.lastName;",
									"var sentCountry = jsonDataReq.country;",
									"var sentDateBirth = jsonDataReq.dateBirth;",
									"",
									"//data received",
									"var jsonDataRes = pm.response.json();",
									"var receivedName = jsonDataRes.data.name;",
									"var receivedLastName = jsonDataRes.data.lastName;",
									"var receivedCountry = jsonDataRes.data.country;",
									"var receivedDateRirth = jsonDataRes.data.dateBirth;",
									"",
									"pm.test(\"Name sent and Name received equals\", function () {",
									"    pm.expect(sentName).to.eql(receivedName);",
									"});",
									"",
									"pm.test(\"Last Name sent and Last Name received equals\", function () {",
									"    pm.expect(sentlastName).to.eql(receivedLastName);",
									"});",
									"",
									"pm.test(\"Country sent and Country received equals\", function () {",
									"    pm.expect(sentCountry).to.eql(receivedCountry);",
									"});",
									"",
									"pm.test(\"Received Birth Date is valid\", function () {",
									"    pm.expect(receivedDateRirth).to.match(/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?(([+-]\\d\\d:\\d\\d)|Z)?$/);",
									"});",
									"",
									"pm.test(\"Birth date sent and Birth date received equals\", function () {",
									"    pm.expect(new Date(sentDateBirth).toISOString()).to.eql(receivedDateRirth);",
									"});",
									"",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
