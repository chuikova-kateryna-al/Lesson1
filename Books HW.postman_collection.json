			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonObject = xml2Json(responseBody);",
									"",
									"",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 200ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(200);",
									"});",
									"",
									"pm.test(\"Successful POST request\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
									"});",
									"",
									"pm.test(\"Link is valid\", function () {",
									"    pm.expect(jsonObject[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"].$[\"xmlns:m\"]).to.eql(\"http://webservices.daehosting.com/ISBN\");",
									"});",
									"pm.test(\"Book found\", function () {",
									"    pm.expect(jsonObject[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"][\"m:IsValidISBN13Result\"]).to.eql(\"true\");",
									"});",
									"",
									"pm.test(\"Content-Type is present\", function () {",
									"    pm.response.to.have.header(\"Content-Type\");",
									"});",
									"",
									"pm.test(\"Another check for book found\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"true\");",
									"});",
									"",
									"pm.test(\"Content-Type is utf-8\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"text/xml; charset=utf-8\");",
									"});",
									"",
									"pm.test(\"Content-Lenth is correct\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Length\")).to.eql(\"302\");",
									"});",
									"",
									"pm.test(\"Date is correct\", function () {",
									"    pm.expect(pm.response.headers.get(\"Date\")).to.include(\"Nov 2024\");",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
